# Copy this file to .env (repo root) and fill in your own values.
# CloudClean runs fully in Demo Mode with none of these set.

# Google Cloud OAuth client (see README "Google Cloud Setup" for step-by-step instructions)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# Random string used to sign session cookies — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Where the frontend runs (used for post-login redirects and CORS)
FRONTEND_URL=http://localhost:5173

# SQLite by default — no separate database server needed
DATABASE_URL=sqlite:///./data/cloudclean.db
