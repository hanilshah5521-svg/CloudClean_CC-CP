# Copy this file to .env (repo root) and fill in your own values.
# CloudClean runs fully in Demo Mode with none of these set.

# Google Cloud OAuth client (see README "Google Cloud Setup" for step-by-step instructions)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# Also request Gmail access (gmail.modify) to find and trash large emails.
# Add the scope .../auth/gmail.modify to your OAuth consent screen.
GMAIL_ENABLED=true

# Signs session cookies and derives the key that encrypts OAuth tokens at
# rest. Leave blank locally (a random one is generated into
# backend/data/.secret_key). In production set it explicitly:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Optional separate Fernet key for token encryption:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# true whenever the app is served over HTTPS (any real deployment)
COOKIE_SECURE=false

# Where the frontend runs (used for post-login redirects and CORS)
FRONTEND_URL=http://localhost:5173

# SQLite by default — no separate database server needed
DATABASE_URL=sqlite:///./data/cloudclean.db

# --- Background worker (python -m app.worker) ---
# Hour (UTC) when auto-compression rules are checked each day. 21 = 02:30 IST.
RULES_HOUR_UTC=21
# At most this many compressions an auto-apply rule starts per night.
RULES_MAX_AUTO_APPLY=3

# --- Video compression (needs ffmpeg + ffprobe; see README) ---
# Blank = found on PATH (on Windows also in winget's install folder).
FFMPEG_PATH=
FFPROBE_PATH=
# H.264 quality: lower = better quality and bigger files (23-28 is sensible).
VIDEO_CRF=27
VIDEO_PRESET=medium
# ffmpeg threads. 2 keeps a 1 GB free-tier VM out of memory trouble.
VIDEO_THREADS=2
# Videos above this are skipped; the worker needs ~2x this in free disk space.
VIDEO_MAX_MB=4096
# Where videos are downloaded and re-encoded (blank = the OS temp dir).
JOB_TEMP_DIR=
