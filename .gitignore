# ---------------------------------------------------------------- secrets
# Google OAuth client ID/secret, encryption key, AWS keys. Copy .env.example.
.env
.env.*
!.env.example
backend/.env
# Downloaded Google OAuth client files
client_secret*.json
credentials*.json
token*.json

# ------------------------------------------------------------ app data
# SQLite database (users, encrypted OAuth tokens, file metadata) and the
# token-encryption key the backend generates on first run.
backend/data/*.db
backend/data/*.db-journal
backend/data/*.db-wal
backend/data/*.db-shm
backend/data/.secret_key

# Tester package built by scripts/make_share_zip.py (share it, don't commit it)
share/

# ----------------------------------------------------------------- Python
backend/venv/
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------- Node
node_modules/
frontend/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ------------------------------------------------------------ logs / misc
*.log
*.ffmpeg.log

# ---------------------------------------------------------- editors / OS
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
# Local Claude Code settings (machine-specific)
.claude/settings.local.json
